{
  "name": "campfin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "typecheck": "tsc -b",
    "db:push:test": "pnpm dlx instant-cli@latest push --app \"$(grep -m1 '^VITE_INSTANT_APP_ID=' .env.local | cut -d= -f2-)\"",
    "db:push:prod": "pnpm dlx instant-cli@latest push --app \"$(grep -m1 '^VITE_INSTANT_APP_ID=' .env.prod.local | cut -d= -f2-)\""
  },
  "dependencies": {
    "@instantdb/react": "^1.0.49",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
