# Vite only exposes variables prefixed VITE_ to the client.
#
# Copy to .env.local and fill in the TEST app id — .env.local is read in every Vite mode,
# so it is the default and what `pnpm dev:test` uses.
#
# Then copy it again to .env.prod.local with the PRODUCTION app id and VITE_APP_ENV=prod.
# `pnpm dev:prod` passes `--mode prod`, which layers that file on top.

# InstantDB app id, from the dashboard at https://instantdb.com/dash. Not a secret — it
# ships inside the client bundle — but each environment has its own app, so the two ids
# must never be swapped.
VITE_INSTANT_APP_ID=

# Which database this build talks to. Exactly `prod` marks the real camp data; anything
# else (including leaving it blank) is treated as a test build and says so in the footer.
VITE_APP_ENV=test
