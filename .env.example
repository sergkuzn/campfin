# Vite only exposes variables prefixed VITE_ to the client.
#
# Copy to .env.dev.local with the DEV app id, and again to .env.prod.local with the
# PRODUCTION app id and VITE_APP_ENV=prod. Vite loads `.env.[mode].local`, so each file is
# picked up only by the commands that name its mode: `pnpm dev` / `pnpm build:dev` read the
# first, `pnpm dev:prod` / `pnpm build:prod` the second. There is no mode-less default, so a
# command can never quietly reach the wrong database.

# InstantDB app id, from the dashboard at https://instantdb.com/dash. Not a secret — it
# ships inside the client bundle — but each environment has its own app, so the two ids
# must never be swapped.
VITE_INSTANT_APP_ID=

# Which database this build talks to. Exactly `prod` marks the real camp data; anything
# else (including leaving it blank) is treated as a dev build and says so in the footer.
VITE_APP_ENV=dev
